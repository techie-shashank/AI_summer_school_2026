# Copy this file to ".env" (same folder) and fill in your real credentials.
# ".env" is listed in .gitignore and will never be committed or pushed.

# KKY Ollama server (provided by the summer school organizers)
KKY_OLLAMA_UNAME=
KKY_OLLAMA_PASSWORD=
KKY_OLLAMA_SERVER=https://ollama.kky.zcu.cz

# OpenAI (only needed if you use the openai=True backend)
OPENAI_API_KEY=

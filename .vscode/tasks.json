{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Train CNN",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/train.py",
                "--config",
                "${workspaceFolder}/config.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Evaluate CNN",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/evaluation.py",
                "--config",
                "${workspaceFolder}/config.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
